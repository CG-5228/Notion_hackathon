# Copy to .env.demo for the admin-only local provisioning command.
# Use an isolated demo project. Keep Auth -> Email -> Confirm email enabled.
# Never add a service-role key to a VITE_ variable or browser bundle.
SUPABASE_URL=https://YOUR_DEMO_PROJECT_REF.supabase.co
SUPABASE_DEMO_PROJECT_REF=YOUR_DEMO_PROJECT_REF
SUPABASE_SERVICE_ROLE_KEY=
